# NexusAI backend configuration.
# Copy this file to `.env` and uncomment / edit values you want to override.
# All values are optional - the launchers fall back to sane defaults.

# --- HTTP server ---------------------------------------------------------
# Interface uvicorn binds to. Use 0.0.0.0 for "all interfaces"
# (recommended in dev). Use 127.0.0.1 to restrict to localhost.
# BACKEND_HOST=0.0.0.0

# Port uvicorn listens on. Pick a free port if 8000 is taken.
# BACKEND_PORT=8000


# --- Optional: GPT-4 teacher (training data quality booster) -------------
# Required only if you pass --use-teacher to the data exporter, or if you
# call /training/finetune/* with use_teacher=true.
# OPENAI_API_KEY=sk-...
# NEXUSAI_TEACHER_MODEL=gpt-4o-mini


# --- Optional: future LLM-backed engine ----------------------------------
# Toggle on once you wire up an LLM-backed PromptEngine.
# NEXUSAI_USE_LLM=1
# NEXUSAI_LLM_URL=http://localhost:11434/api/chat
